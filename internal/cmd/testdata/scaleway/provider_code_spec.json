{
	"provider": {
		"name": "scaleway"
	},
	"resources": [
		{
			"name": "instance_image",
			"schema": {
				"attributes": [
					{
						"name": "arch",
						"string": {
							"computed_optional_required": "computed_optional",
							"default": {
								"static": "x86_64"
							},
							"description": "Architecture of the image.",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.OneOf(\n\"x86_64\",\n\"arm\",\n)"
									}
								}
							]
						}
					},
					{
						"name": "default_bootscript",
						"string": {
							"computed_optional_required": "computed_optional",
							"deprecation_message": "This attribute is deprecated.",
							"description": "Default bootscript of the image."
						}
					},
					{
						"name": "extra_volumes",
						"single_nested": {
							"computed_optional_required": "computed_optional",
							"attributes": [
								{
									"name": "extra_volume_key",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "id",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "UUID of the volume."
												}
											},
											{
												"name": "name",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "Name of the volume."
												}
											},
											{
												"name": "organization",
												"string": {
													"computed_optional_required": "computed_optional",
													"deprecation_message": "This attribute is deprecated.",
													"description": "Organization ID of the volume."
												}
											},
											{
												"name": "project",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "Project ID of the volume."
												}
											},
											{
												"name": "size",
												"int64": {
													"computed_optional_required": "computed_optional",
													"description": "Disk size of the volume, must be a multiple of 512. (in bytes)"
												}
											},
											{
												"name": "volume_type",
												"string": {
													"computed_optional_required": "computed_optional",
													"default": {
														"static": "l_ssd"
													},
													"description": "Type of the volume.",
													"validators": [
														{
															"custom": {
																"imports": [
																	{
																		"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																	}
																],
																"schema_definition": "stringvalidator.OneOf(\n\"l_ssd\",\n\"b_ssd\",\n\"unified\",\n)"
															}
														}
													]
												}
											}
										]
									}
								}
							],
							"description": "Additional volumes of the image."
						}
					},
					{
						"name": "name",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "Name of the image."
						}
					},
					{
						"name": "organization",
						"string": {
							"computed_optional_required": "computed_optional",
							"deprecation_message": "This attribute is deprecated.",
							"description": "Organization ID of the image."
						}
					},
					{
						"name": "project",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "Project ID of the image."
						}
					},
					{
						"name": "public",
						"bool": {
							"computed_optional_required": "computed_optional",
							"description": "True to create a public image."
						}
					},
					{
						"name": "root_volume",
						"string": {
							"computed_optional_required": "required",
							"description": "UUID of the snapshot."
						}
					},
					{
						"name": "tags",
						"list": {
							"computed_optional_required": "computed_optional",
							"element_type": {
								"string": {}
							},
							"description": "The tags of the image."
						}
					},
					{
						"name": "zone",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "The zone you want to target",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.OneOf(\n\"fr-par-1\",\n\"fr-par-2\",\n\"fr-par-3\",\n\"nl-ams-1\",\n\"nl-ams-2\",\n\"pl-waw-1\",\n\"pl-waw-2\",\n)"
									}
								}
							]
						}
					},
					{
						"name": "image_id",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "UUID of the image you want to get."
						}
					}
				],
				"description": "Images are backups of your instances.\nYou can reuse that image to restore your data or create a series of instances with a predefined configuration.\n\nAn image is a complete backup of your server including all volumes.\n",
				"markdown_description": "Images are backups of your instances.\nYou can reuse that image to restore your data or create a series of instances with a predefined configuration.\n\nAn image is a complete backup of your server including all volumes.\n"
			}
		},
		{
			"name": "instance_ip",
			"schema": {
				"attributes": [
					{
						"name": "organization",
						"string": {
							"computed_optional_required": "computed_optional",
							"deprecation_message": "This attribute is deprecated.",
							"description": "The organization ID the IP is reserved in."
						}
					},
					{
						"name": "project",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "The project ID the IP is reserved in."
						}
					},
					{
						"name": "server",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "UUID of the server you want to attach the IP to."
						}
					},
					{
						"name": "tags",
						"list": {
							"computed_optional_required": "computed_optional",
							"element_type": {
								"string": {}
							},
							"description": "The tags of the IP."
						}
					},
					{
						"name": "ip",
						"single_nested": {
							"computed_optional_required": "computed",
							"attributes": [
								{
									"name": "address",
									"string": {
										"computed_optional_required": "computed",
										"description": "(IPv4 address)"
									}
								},
								{
									"name": "id",
									"string": {
										"computed_optional_required": "computed"
									}
								},
								{
									"name": "organization",
									"string": {
										"computed_optional_required": "computed"
									}
								},
								{
									"name": "project",
									"string": {
										"computed_optional_required": "computed"
									}
								},
								{
									"name": "reverse",
									"string": {
										"computed_optional_required": "computed"
									}
								},
								{
									"name": "server",
									"single_nested": {
										"computed_optional_required": "computed",
										"attributes": [
											{
												"name": "id",
												"string": {
													"computed_optional_required": "computed"
												}
											},
											{
												"name": "name",
												"string": {
													"computed_optional_required": "computed"
												}
											}
										]
									}
								},
								{
									"name": "tags",
									"list": {
										"computed_optional_required": "computed",
										"element_type": {
											"string": {}
										}
									}
								},
								{
									"name": "zone",
									"string": {
										"computed_optional_required": "computed"
									}
								}
							]
						}
					},
					{
						"name": "zone",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "The zone you want to target",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.OneOf(\n\"fr-par-1\",\n\"fr-par-2\",\n\"fr-par-3\",\n\"nl-ams-1\",\n\"nl-ams-2\",\n\"pl-waw-1\",\n\"pl-waw-2\",\n)"
									}
								}
							]
						}
					}
				],
				"description": "A flexible IP address is an IP address which you hold independently of any server.\nYou can attach it to any of your servers and do live migration of the IP address between your servers.\n\nBe aware that attaching a flexible IP address to a server will remove the previous public IP address of the server and cut any ongoing public connection to the server.\n",
				"markdown_description": "A flexible IP address is an IP address which you hold independently of any server.\nYou can attach it to any of your servers and do live migration of the IP address between your servers.\n\nBe aware that attaching a flexible IP address to a server will remove the previous public IP address of the server and cut any ongoing public connection to the server.\n"
			}
		}
	],
	"version": "0.1"
}